# Orda wiring for enatega-multivendor-web (customer web).
# Apollo builds the endpoint as `${NEXT_PUBLIC_SERVER_URL}graphql`, so these
# are the HOST ROOT with a trailing slash — NOT the /graphql path.
#
# Local dev against a backend on localhost:5000:
#   NEXT_PUBLIC_SERVER_URL="http://localhost:5000/"
#   NEXT_PUBLIC_WS_SERVER_URL="ws://localhost:5000/"
#
# Production: the per-restaurant domain (Caddy proxies /graphql + wss to the
# .NET backend — see orda infra/templates).
NEXT_PUBLIC_SERVER_URL="https://api.dagiovanni-bochum.de/"
NEXT_PUBLIC_WS_SERVER_URL="wss://api.dagiovanni-bochum.de/"
